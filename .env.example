# Create the bot with @BotFather and paste the token here.
BOT_TOKEN=123456789:replace_me

# Your numeric Telegram user ID. You can get it from @userinfobot.
ADMIN_IDS=123456789

# IANA timezone used for daily schedules and deadlines.
TIMEZONE=Europe/Moscow

# Optional automatic poll time (HH:MM). Leave empty for manual /poll only.
DAILY_POLL_TIME=19:00

# Default number of hours before a manually created poll closes.
DEFAULT_DEADLINE_HOURS=4

# SQLite file inside the container. Keep this path for the supplied compose file.
DATABASE_URL=sqlite+aiosqlite:////app/data/bot.db

# Keep aggregate-only history this many days. Individual votes are erased on close.
AGGREGATE_RETENTION_DAYS=30

# INFO is recommended. The app never logs message contents or vote choices.
LOG_LEVEL=INFO

# Public HTTPS address of the Telegram Mini App. Leave empty until the game site is published.
MINI_APP_URL=

# Domain pointed to the VPS. Production Compose derives MINI_APP_URL from it.
GAME_DOMAIN=games.example.com
